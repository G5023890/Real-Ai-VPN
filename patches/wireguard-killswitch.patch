+                if range.address is IPv4Address {
+                    ipv4Routes.append(NEIPv4Route(destinationAddress: "\(range.address)", subnetMask: "\(range.subnetMask())"))
+                } else if range.address is IPv6Address {
+                    ipv6Routes.append(NEIPv6Route(destinationAddress: "\(range.address)", networkPrefixLength: NSNumber(value: range.networkPrefixLength)))
+                }
+            }
+        }
+        return (ipv4Routes, ipv6Routes)
+    }
